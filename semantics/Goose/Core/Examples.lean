namespace Goose.Core.Examples

open Run

/-- The answer and exit status of `run` on a module given as text. -/
def run (settings : Settings) (module : String) : String × UInt32 :=
  runBytes settings module.toUTF8

def check (settings : Settings) (module : String) (line : String) (status : UInt32) : Bool :=
  run settings module == (line, status)

